# =========================================================================
# Backend environment variables
# Copy this file to `apps/backend/.env` and fill in the required values.
# =========================================================================

# --- Process -------------------------------------------------------------
# `production` enforces DATABASE_URL + JIRA_WEBHOOK_SECRET. Leave unset or
# set to `development` for local work.
NODE_ENV=development
PORT=4000

# Public origin of the backend, e.g. `https://jira-figma.example.com`. Used
# to log the webhook URL for registration. Defaults to http://localhost:$PORT.
PUBLIC_BASE_URL=

# --- Atlassian OAuth 2.0 (3LO) -------------------------------------------
# Create an app at https://developer.atlassian.com/console/myapps/
# Enable the "Jira platform REST API" and add scopes:
#   read:me, read:jira-user, read:jira-work, offline_access
# The redirect URL must match exactly (scheme, host, port, path).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:4000/auth/jira/callback

# --- Postgres ------------------------------------------------------------
# Required in production. In development, unset = in-memory stores (state
# lost on restart). Managed-Postgres hostnames (Neon/Supabase/RDS/...) are
# auto-detected and SSL is enabled unless sslmode=disable is in the URL.
# Example (local):  postgres://figma:figma@localhost:5432/figma_jira_dev
DATABASE_URL=

# --- Jira webhook security ----------------------------------------------
# Random string used as a path segment on the webhook URL. Jira Cloud
# OAuth-app webhooks don't support HMAC signatures, so this is our trust
# anchor. Generate with:  openssl rand -hex 32
# When set, the webhook URL is:
#   ${PUBLIC_BASE_URL}/webhooks/jira/${JIRA_WEBHOOK_SECRET}
# Required in production.
JIRA_WEBHOOK_SECRET=
