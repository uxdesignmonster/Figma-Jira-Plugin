PORT=4000

# Atlassian OAuth 2.0 (3LO)
# Create an app at https://developer.atlassian.com/console/myapps/
# Enable the "Jira platform REST API" and add scopes:
#   read:me, read:jira-user, read:jira-work, offline_access
# The redirect URL must match exactly (including http/https, host, port, path).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:4000/auth/jira/callback

# Phase 3+ (swap InMemoryTokenStore for a real DB).
DATABASE_URL=
