{
  "name": "@figma-jira/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Backend API: owns Jira OAuth tokens, fetches issues, (later) handles webhooks",
  "scripts": {
    "build": "tsc -p tsconfig.json",
