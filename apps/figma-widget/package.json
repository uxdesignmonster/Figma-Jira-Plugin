{
  "name": "@figma-jira/figma-widget",
  "version": "0.0.1",
  "private": true,
  "description": "Figma widget: renders the persistent Jira ticket card on the canvas",
  "scripts": {
    "build": "esbuild src/widget.tsx --bundle --platform=browser --target=es2017 --format=iife --outfile=dist/widget.js --jsx-factory=figma.widget.h --jsx-fragment=figma.widget.Fragment",
    "dev": "esbuild src/widget.tsx --bundle --platform=browser --target=es2017 --format=iife --outfile=dist/widget.js --jsx-factory=figma.widget.h --jsx-fragment=figma.widget.Fragment --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@figma-jira/shared-types": "*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.2",
    "@figma/widget-typings": "^1.10.0",
    "esbuild": "^0.21.5"
  }
}
